{
  "name": "@tadween/dashboard",
  "version": "0.1.0",
  "description": "Tadween content dashboard — an Arabic-first markdown editor for Astro sites, running on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tadween/astro": "workspace:*",
    "hono": "^4.7.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250428.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.14.0"
  }
}
